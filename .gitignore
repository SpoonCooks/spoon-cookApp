# Local environment values. `.env.example` is the committed template; every other variant —
# `.env.staging`, `.env.production` — carries real values and must not be committed. The negation
# has to follow the wildcard, or the wildcard re-ignores the template.
.env
.env.*
!.env.example

# @generated expo-cli sync-2b81b286409207a5da26e14c78851eb30d8ccbdb
# The following patterns were generated by expo-cli

expo-env.d.ts
# @end expo-cli

# Python bytecode from the pixel-verification scripts. Committed once by mistake in run 1;
# the .py files are the source of truth and the cache is machine-specific.
__pycache__/
*.pyc

# Firebase Android config. Supplied per build, never committed: it carries the project's Android
# API key, and which Firebase project a build talks to is an environment decision rather than a
# property of the source. The customer app ignores it for the same reason.
google-services.json
GoogleService-Info.plist
build-output/

# Signing material and service credentials. Matches the customer app, which already ignores these.
#
# A committed signing key is the one credential here that cannot be cleaned up after: it is what
# Android uses to decide an APK is genuinely this app, and replacing it breaks upgrades for every
# handset that already has the app installed. `plugins/withStagingSigning` reads a keystore path
# from Gradle properties, so one really does sit in a working copy on this project.
#
# `credentials.json` is EAS's local signing config (keystore passwords in plaintext);
# `service-account*.json` is the Google service account used to submit builds to Play.
*.keystore
*.jks
*.p8
*.p12
*.key
credentials.json
service-account*.json
